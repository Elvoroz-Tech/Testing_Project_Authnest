# ── Which AuthNest does this app talk to? ────────────────────────────────────
# authnest-server picks the AuthNest BACKEND URL in this order:
#   1. AUTHNEST_BASE_URL            (explicit — use this)
#   2. AUTHNEST_DEV_MODE=true       (shortcut for http://localhost:5000)
#   3. otherwise the hosted production service
# NODE_ENV does NOT choose it. (The previous version of this file said it did; with only
# NODE_ENV=development set, the SDK still called the PRODUCTION service.)
# For a local AuthNest SaaS backend:
AUTHNEST_BASE_URL=http://localhost:5000

# NODE_ENV only affects this app: the default client URL below and whether session cookies are
# marked Secure (they are in production).
NODE_ENV=development

CLIENT_AUTHNEST_API_KEY=
CLIENT_AUTHNEST_SECRET_KEY=

# Optional, but recommended if you've registered more than one website for this Client in the
# AuthNest dashboard — pins link-building (registration/login/etc.) to a specific website's config.
CLIENT_WEBSITE_ID=

# This server's own public URL, used to build callback redirect_uri values.
# Defaults to http://localhost:9000 in development if left blank.
CLIENT_BASE_URL="http://localhost:9000"

# Browser origins allowed to call the session routes that change state (POST /api/authnest/session/refresh,
# /logout, /logout-all). Comma-separated. The frontend normally calls through its own proxy (same origin),
# so this is only needed if you call this backend directly from another origin.
# FRONTEND_ORIGINS=http://localhost:5175

PORT=9000
MONGODB_URI=""
